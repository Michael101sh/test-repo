<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <label>CME Agent Queue Trends</label>
    <interviewLabel>CME Agent Queue Trends</interviewLabel>
    <description>Agent action to analyze case queue volume trends</description>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <name>varUserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>varInsightData</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>varCurrentVolume</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>

    <variables>
        <name>varTrendDirection</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_All_Cases</targetReference>
        </connector>
    </start>

    <recordLookups>
        <name>Get_All_Cases</name>
        <label>Get All Cases</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Build_Trend_Summary</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varUserId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <assignments>
        <name>Build_Trend_Summary</name>
        <label>Build Trend Summary</label>
        <locationX>50</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>varCurrentVolume</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTrendDirection</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>stable</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varInsightData</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Queue Trend Analysis Complete</stringValue>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
